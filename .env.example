# Variables de entorno obligatorias para `docker compose`.
#
# Copia este archivo a `.env` (en la raiz del proyecto) y rellena los valores.
# `.env` esta en .gitignore: NUNCA lo subas al repositorio.
#
# Sin estas variables la API no arranca (fail-fast).

# Contrasena del usuario postgres de la base de datos local.
POSTGRES_PASSWORD=

# Secreto con el que se firman los tokens JWT. Usa un valor largo y aleatorio.
JWT_SECRET=

# Secreto que autoriza las llamadas a los endpoints de cron (/api/webhooks).
CRON_SECRET=

# --- Variables de la API que se leen de api/.env (o del entorno del hosting) ---

# URL pública del cliente web (sin barra final). La API la usa en los enlaces de los correos,
# en la redirección tras verificar la cuenta y como origen permitido por CORS.
# Es obligatoria: sin ella la API no arranca.
CLIENT_URL=

# Orígenes extra permitidos por CORS, separados por comas (opcional, p. ej. un entorno de pruebas).
CORS_ORIGINS=

# Correo que recibe el informe del cron /api/webhooks/health-check. Sin él solo se comprueba la base de datos.
ADMIN_EMAIL=

# Zona horaria de los clubes para «mañana» y «hoy» en los recordatorios (por defecto Europe/Madrid).
APP_TIMEZONE=
