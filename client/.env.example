# Copia este archivo a .env y rellena los valores (no se commitea).
VITE_API_URL=http://localhost:3000/api
# Client ID web de Google (el mismo que usa GoogleOAuthProvider y el login nativo en Android/web).
VITE_GOOGLE_CLIENT_ID=
# Client ID de iOS de Google (solo lo usa el login nativo de la app iOS).
VITE_GOOGLE_IOS_CLIENT_ID=
