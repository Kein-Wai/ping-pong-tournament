<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">#000000</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- 👇 CAMBIADO: Fondo negro para la ventana principal en lugar de @null -->
        <item name="android:windowBackground">#000000</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 👇 AÑADIDO: Esta es la propiedad OBLIGATORIA para Android 12+ -->
        <item name="windowSplashScreenBackground">#000000</item>
        
        <!-- Mantenemos el windowBackground negro para la transición -->
        <item name="android:windowBackground">#000000</item>
        
        <!-- Le decimos a Android que después del Splash cargue el tema principal -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>