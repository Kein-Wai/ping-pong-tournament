datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AnalysisType {
  Light
  Deep
}

enum PointCategory {
  Servicio
  Ataque
  Defensa
  Resto
  FalloSaque
  ErrorNoForzado
  ErrorForzado
  Movilidad
  SinRazon
}

enum PointSubcategory {
  Cortado
  Topeado
  SinEfecto
  Derecha
  Reves
}

enum PointPlacement {
  Derecha
  Reves
  Centro
}

enum KnockoutType {
  A
  B
}



enum MatchLocation {
  Casa
  Fuera
}

enum ManualMatchType {
  Liga
  Competicion
  Amistoso
}

enum MatchFormat {
  Individual
  Equipos
}

enum OpponentLevel {
  Peor
  Igual
  Mejor
}

enum DominantHand {
  Diestro
  Zurdo
}

enum Playstyle {
  Ofensivo
  Defensivo
}

enum ExerciseCategory {
  Control_CT
  Bloqueo_Contraataque
  Movilidad_Lateral
  Movilidad_Pivot
  Semi_Variables
  Recepcion_Flip_Reves
  Recepciones_Cortas
  Recepciones_Largas
  Recepciones_Cortas_Largas
  Recepcion_Saques_Intermedios
  Saques_Largos
  Servicios_Ataque
  Individuales
}

enum TrainingStatus {
  Activo
  Completado
  Cancelado
}

enum TypeUser {
  SuperAdmin
  AdminClub
  Player
}

model UserType {
  id    String   @id @default(uuid())
  name  TypeUser @unique
  users User[]

  @@map("user_type")
}

enum MatchStatus {
  Programado
  Iniciado
  Abierto
  Completado
  Cancelado
}

enum TournamentStatus {
  Programado
  Iniciado
  Grupos
  R128avos
  R64avos
  R32avos
  R16avos
  Octavos
  Cuartos
  Semifinales
  Final
  Completado
  Cancelado
}

enum PlayerTournamentStatus {
  Pendiente
  Confirmado
  NoPresentado
}

enum TypeTournament {
  Interno
  Abierto
  Oficial
}

enum LevelTournament {
  Principiante
  Intermedio
  Avanzado
  Federado
  Mixto
}

enum Rounds {
  TodosvsTodos
  GruposKnockout
  Knockout
}

enum RoundKnockouts {
  R128avos
  R64avos
  R32avos
  R16avos
  Octavos
  Cuartos
  Semifinales
  Final
}

enum TypeKnockout {
  LlaveA
  LlaveAB
}

enum SortKnockout {
  Siembra
  Aleatorio
}

enum SortGroups {
  Snake
  Aleatorio
}

enum ClubStatus {
  Pendiente
  Aprobado
  Inactivo
}

enum UserClubStatus {
  Registrado
  Pendiente
  Aprobado
  Rechazado
}

enum PlayerLevel {
  Iniciacion
  Principiante
  Intermedio
  Avanzado
  Profesional
}

enum UpdateSourceType {
  EntrenamientoGeneral
  EntrenamientoEspecifico
  Partido
}

enum SkillUpdateStatus {
  EXPECTED
  COMPLETED
  REJECTED
}

enum FeedbackType {
  Bug
  Sugerencia
}

enum FeedbackStatus {
  Pendiente
  Revisado
  Resuelto
}

enum EventRegion {
  Club
  Local
  Regional
  Provincial
  Autonomico
  Nacional
  Internacional
}

model Club {
  id        String     @id @default(uuid())
  name      String     @unique @db.VarChar(255)
  status    ClubStatus @default(Pendiente)

  city      String     @db.VarChar(255)
  address   String?    @db.VarChar(255)
  foundedAt DateTime?  @map("founded_at")

  createdAt DateTime   @default(now()) @map("created_at")

  // Relaciones
  users              User[]
  tournaments        Tournament[]
  leagues            League[]
  exercises          Exercise[]
  generalSchedules   GeneralTrainingSchedule[]
  generalTrainings   GeneralTraining[]
  generalAttendances GeneralTrainingAttendance[]
  teams              Team[]
  events             ClubEvent[]
  @@map("club")
}

model Season {
  id        String   @id @default(uuid())
  name      String   @unique // Ej: "Temporada 2026/2027"
  startDate DateTime @db.Date @map("start_date")
  endDate   DateTime @db.Date @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  
  // Relaciones
  stats            Stats[]
  skills           PlayerSkills[]
  tournaments      Tournament[]
  teams            Team[]
  generalTrainings GeneralTraining[]
  matches          Match[]
  manualMatches    ManualMatch[]
  leagues          League[]
  playerTrainings  PlayerTraining[]
  events           ClubEvent[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("season")
}

model User {
  id                 String          @id @default(uuid())
  userTypeId         String          @map("user_type_id")

  clubId             String?         @map("club_id")
  clubStatus         UserClubStatus? @default(Registrado) @map("club_status")
  name               String          @db.VarChar(255)
  surname            String?         @db.VarChar(255)
  password           String?
  authProvider       String          @default("LOCAL")
  googleId           String?         @unique
  secondSurname      String?         @map("secondsurname") @db.VarChar(255)
  nickname           String?         @db.VarChar(255)
  avatarUrl          String?
  email              String          @unique @db.VarChar(255)
  verificationToken  String?         @db.VarChar(255)
  resetPasswordToken String?         @db.VarChar(255) 
  resetPasswordExpires DateTime?
  active             Boolean         @default(false)
  dominantHand       DominantHand?   @map("dominant_hand")
  playstyle          Playstyle?
  level              PlayerLevel?
  
  // Relaciones
  club                          Club?                   @relation(fields: [clubId], references: [id])
  userType                      UserType                @relation(fields: [userTypeId], references: [id])
  stats                         Stats[]
  matchesAsPlayerOne            Match[]                 @relation("PlayerOne")
  matchesAsPlayerTwo            Match[]                 @relation("PlayerTwo")
  groupClasifications           TournamentGroupClas[]
  leagueClasifications          LeagueClas[]
  tournamentInscriptions        TournamentParticipant[]
  tournamentgroupClasifications TournamentClas[]
  trainings                     PlayerTraining[]
  manualMatches                 ManualMatch[]
  skills                        PlayerSkills[]      
  skillUpdates                  PlayerSkillUpdate[]
  generalAttendances            GeneralTrainingAttendance[]
  teams                         Team[]
  feedbacks                     AppFeedback[]
  eventReminders                EventReminder[]
  @@index([name, email], name: "user_name_email_index")
  @@map("user")
}

model Exercise {
  id          String           @id @default(uuid())
  clubId      String?          @map("club_id")
  name        String           @db.VarChar(255)
  description String           @db.Text
  category    ExerciseCategory
  code        Int?

  // Relaciones
  club     Club?             @relation(fields: [clubId], references: [id])
  sessions SessionExercise[] 

  @@map("exercise")
}

model PlayerTraining {
  id              String         @id @default(uuid())
  playerId        String         @map("player_id")
  seasonId        String?        @map("season_id")
  strengths       String         @db.Text
  weaknesses      String         @db.Text
  objectives      String         @db.Text
  sessionsPerWeek Int            @map("sessions_per_week")
  weeks           Int
  status          TrainingStatus @default(Activo)
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date

  // Relaciones
  player   User              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season   Season?           @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  sessions TrainingSession[]

  @@map("player_training")
}

model TrainingSession {
  id               String   @id @default(uuid())
  playerTrainingId String   @map("player_training_id")
  date             DateTime @db.Date

  // Relaciones
  training     PlayerTraining      @relation(fields: [playerTrainingId], references: [id], onDelete: Cascade)
  exercises    SessionExercise[]
  skillUpdates PlayerSkillUpdate[]

  @@map("training_session")
}

model SessionExercise {
  id                String  @id @default(uuid())
  trainingSessionId String  @map("training_session_id")
  exerciseId        String  @map("exercise_id")

  sets            Int? 
  reps            Int? 
  durationMinutes Int? 
  completed       Boolean @default(false) 
  notes           String? @db.Text 

  // Relaciones
  session  TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id])

  @@map("session_exercise")
}

model Stats {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  seasonId       String? @map("season_id")
  elo            Int?    @default(500)
  matchWon       Int?    @map("match_won")
  matchLost      Int?    @map("match_lost")
  setWon         Int?    @map("set_won")
  setLost        Int?    @map("set_lost")
  pointWon       Int?    @map("point_won")
  pointLost      Int?    @map("point_lost")
  tournamentWon  Int?    @map("tournament_won")
  tournamentPart Int?    @map("tournament_part") 

  // Relaciones
  user   User    @relation(fields: [userId], references: [id])
  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@map("stats")
}

model Match {
  id                  String       @id @default(uuid())
  dateStart           DateTime     @map("datestart") @db.Date
  seasonId            String?      @map("season_id")
  tournamentId        String?      @map("tournament_id")
  groupId             String?      @map("group_id")
  knockoutId          String?      @map("knockout_id")
  leagueId            String?      @map("league_id")
  matchOrder          Int?         @default(0) @map("match_order")
  playerOneId         String       @map("player_one")
  playerTwoId         String       @map("player_two")

  setOnePlayerOne     Int?         @default(0) @map("set_one_player_one")
  setOnePlayerTwo     Int?         @default(0) @map("set_one_player_two")
  setTwoPlayerOne     Int?         @default(0) @map("set_two_player_one")
  setTwoPlayerTwo     Int?         @default(0) @map("set_two_player_two")
  setThreePlayerOne   Int?         @default(0) @map("set_three_player_one")
  setThreePlayerTwo   Int?         @default(0) @map("set_three_player_two")
  setFourPlayerOne    Int?         @default(0) @map("set_four_player_one")
  setFourPlayerTwo    Int?         @default(0) @map("set_four_player_two")
  setFivePlayerOne    Int?         @default(0) @map("set_five_player_one")
  setFivePlayerTwo    Int?         @default(0) @map("set_five_player_two")
  setSixPlayerOne     Int?         @default(0) @map("set_six_player_one")
  setSixPlayerTwo     Int?         @default(0) @map("set_six_player_two")
  setSevenPlayerOne   Int?         @default(0) @map("set_seven_player_one")
  setSevenPlayerTwo   Int?         @default(0) @map("set_seven_player_two")
  
  status              MatchStatus? @default(Programado)
  winnerGoesToMatchId String?      @map("winner_goes_to")
  loserGoesToMatchId  String?      @map("loser_goes_to")

  // Relaciones
  season       Season?             @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  tournament   Tournament?         @relation(fields: [tournamentId], references: [id])
  group        TournamentGroup?    @relation(fields: [groupId], references: [id])
  knockout     TournamentKnockout? @relation(fields: [knockoutId], references: [id])
  league       League?             @relation(fields: [leagueId], references: [id])
  playerOne    User                @relation("PlayerOne", fields: [playerOneId], references: [id], map: "match_player_one_foreign")
  playerTwo    User                @relation("PlayerTwo", fields: [playerTwoId], references: [id], map: "match_player_two_foreign")
  skillUpdates PlayerSkillUpdate[]

  @@map("match")
}

model Tournament {
  id                String            @id @default(uuid())
  dateStart         DateTime          @map("datestart") @db.Date
  clubId            String?           @map("club_id")
  seasonId          String?           @map("season_id")
  name              String            @db.VarChar(255)
  numPlayers        Int               @map("num_players")
  numGroup          Int?              @map("num_group")
  numGroupPlayers   Int?              @map("num_group_players")
  typeTournament    TypeTournament?   @default(Interno) @map("type_tournament")
  levelTournament   LevelTournament?  @default(Mixto) @map("level_tournament")
  rounds            Rounds?           @default(GruposKnockout)
  status            TournamentStatus? @default(Programado)
  typeKnockout      TypeKnockout?     @default(LlaveA) @map("type_knockout")
  playersKnockout   Int?              @map("players_knockout")
  sortGroups        SortGroups?       @default(Snake) @map("sort_groups")
  sortKnockout      SortKnockout?     @default(Siembra) @map("sort_knockout")
  allPos            Boolean?          @map("all_pos")
  groupsCreated     Boolean?          @default(false) @map("groups_created")
  knockoutCreated   Boolean?          @default(false) @map("knockout_created")
  setsToWinGroup    Int?              @default(2) @map("sets_to_win_group")
  setsToWinKnockout Int?              @default(3) @map("sets_to_win_knockout")
  
  // Relaciones
  matches           Match[]
  groups            TournamentGroup[]
  knockouts         TournamentKnockout[]
  participants      TournamentParticipant[]
  clasifications    TournamentClas[]
  club              Club?             @relation(fields: [clubId], references: [id])
  season            Season?           @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@map("tournament")
}

model TournamentClas {
  id           String          @id @default(uuid())
  tournamentId String          @map("tournament_group_id")
  playerId     String          @map("player_id")
  lastRound    RoundKnockouts?
  position     Int?            @default(0)

  // Relaciones
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     User       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("tournament_clas")
}

model League {
  id              String           @id @default(uuid())
  clubId          String?          @map("club_id")
  seasonId        String?          @map("season_id")
  dateStart       DateTime         @map("datestart") @db.Date
  name            String           @unique @db.VarChar(255)
  numPlayers      Int              @map("num_players")
  typeTournament  TypeTournament?  @default(Interno) @map("type_tournament")
  levelTournament LevelTournament? @default(Mixto) @map("level_tournament")
  status          MatchStatus?     @default(Programado)

  // Relaciones
  matches        Match[]
  clasifications LeagueClas[]
  club           Club?        @relation(fields: [clubId], references: [id])
  season         Season?      @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@map("league")
}

model TournamentParticipant {
  id           String                  @id @default(uuid())
  tournamentId String                  @map("tournament_id")
  playerId     String                  @map("player_id")
  registeredAt DateTime                @default(now()) @map("registered_at")
  status       PlayerTournamentStatus? @default(Pendiente)

  // Relaciones
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     User       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@map("tournament_participant")
}

model TournamentGroup {
  id           String       @id @default(uuid())
  tournamentId String       @map("tournament_id")
  group        Int
  status       MatchStatus? @default(Programado)

  // Relaciones
  tournament     Tournament            @relation(fields: [tournamentId], references: [id])
  matches        Match[]
  clasifications TournamentGroupClas[]

  @@map("tournament_group")
}

model TournamentKnockout {
  id           String         @id @default(uuid())
  type         KnockoutType   @default(A)
  tournamentId String         @map("tournament_id")
  round        RoundKnockouts
  status       MatchStatus?   @default(Programado)
  positions    String?        @db.VarChar(50)

  // Relaciones
  tournament Tournament @relation(fields: [tournamentId], references: [id])
  matches    Match[]

  @@map("tournament_knockout")
}

model TournamentGroupClas {
  id                String @id @default(uuid())
  tournamentGroupId String @map("tournament_group_id")
  playerId          String @map("player_id")
  played            Int?   @default(0) @map("played")
  gamesWon          Int?   @default(0) @map("games_won")
  gamesLost         Int?   @default(0) @map("games_lost")
  setsWon           Int?   @default(0) @map("sets_won")
  setsLost          Int?   @default(0) @map("sets_lost")
  pointsWon         Int?   @default(0) @map("points_won")
  pointsLost        Int?   @default(0) @map("points_lost")
  pointsClas        Int?   @default(0) @map("points_clas")
  position          Int    @default(0)

  // Relaciones
  tournamentGroup TournamentGroup @relation(fields: [tournamentGroupId], references: [id])
  player          User            @relation(fields: [playerId], references: [id])

  @@map("tournament_group_clas")
}

model LeagueClas {
  id         String  @id @default(uuid())
  leagueId   String  @map("league_id")
  playerId   String  @map("player_id")
  played     Int?    @default(0) @map("played")
  gamesWon   Int?    @default(0) @map("games_won")
  gamesLost  Int?    @default(0) @map("games_lost")
  setsWon    Int?    @default(0) @map("sets_won")
  setsLost   Int?    @default(0) @map("sets_lost")
  pointsWon  Int?    @default(0) @map("points_won")
  pointsLost Int?    @default(0) @map("points_lost")
  pointsClas Int?    @default(0) @map("points_clas")
  position   Int?    @default(0)
  status     String? @db.VarChar(255)

  // Relaciones
  league League @relation(fields: [leagueId], references: [id])
  player User   @relation(fields: [playerId], references: [id])

  @@map("league_clas")
}

model ManualMatch {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  seasonId        String?          @map("season_id")
  date            DateTime         @db.Date
  location        MatchLocation
  matchType       ManualMatchType  @map("match_type")
  format          MatchFormat
  setsToWin       Int              @default(3) @map("sets_to_win")
  
  opponentName    String           @map("opponent_name") @db.VarChar(255)
  opponentHand    DominantHand?    @map("opponent_hand")
  opponentStyle   Playstyle?       @map("opponent_style")
  opponentLevel   OpponentLevel?   @map("opponent_level")
  
  status          MatchStatus      @default(Programado)
  mySets          Int              @default(0) @map("my_sets")
  opponentSets    Int              @default(0) @map("opponent_sets")

  // 👇 NUEVOS CAMPOS PARA LIGHT VS DEEP
  analysisType    AnalysisType     @default(Deep) @map("analysis_type")
  lightNotes      String?          @db.Text @map("light_notes")
  
  // Relaciones
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  season          Season?          @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  points          PointAnalysis[]

  @@map("manual_match")
}

model PointAnalysis {
  id              String           @id @default(uuid())
  manualMatchId   String           @map("manual_match_id")
  
  setNumber       Int              @map("set_number")
  pointOrder      Int              @map("point_order")
  isWon           Boolean          @map("is_won")      
  
  // 👇 NUEVA TAXONOMÍA DE PUNTOS
  category        PointCategory?  
  subcategory     PointSubcategory?  
  placement       PointPlacement? 
  
  // Relaciones
  match           ManualMatch      @relation(fields: [manualMatchId], references: [id], onDelete: Cascade)

  @@map("point_analysis")
}

model PlayerSkills {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  seasonId        String?  @map("season_id")
  
  derechaPlano    Float    @default(0)
  revesPlano      Float    @default(0)
  topspinDerecha  Float    @default(0)
  topspinReves    Float    @default(0)
  corte           Float    @default(0)
  bloqueoDerecha  Float    @default(0)
  bloqueoReves    Float    @default(0)
  servicio        Float    @default(0)
  recepcion       Float    @default(0)
  movilidad       Float    @default(0)
  fortalezaMental Float    @default(0)
  experiencia     Float    @default(0)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season          Season?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@map("player_skills")
}

model SkillUpdateTemplate {
  id              String           @id @default(uuid())
  name            String           @db.VarChar(255)
  sourceType      UpdateSourceType @map("source_type")
  
  derechaPlano    Boolean @default(false)
  revesPlano      Boolean @default(false)
  topspinDerecha  Boolean @default(false)
  topspinReves    Boolean @default(false)
  corte           Boolean @default(false)
  bloqueoDerecha  Boolean @default(false)
  bloqueoReves    Boolean @default(false)
  servicio        Boolean @default(false)
  recepcion       Boolean @default(false)
  movilidad       Boolean @default(false)
  fortalezaMental Boolean @default(false)
  experiencia     Boolean @default(false)

  generalTrainings GeneralTraining[]

  @@map("skill_update_template")
}

model PlayerSkillUpdate {
  id              String            @id @default(uuid())
  playerId        String            @map("player_id")
  date            DateTime          @default(now()) @db.Date
  status          SkillUpdateStatus @default(EXPECTED)
  sourceType      UpdateSourceType  @map("source_type")

  derechaPlano    Float @default(0)
  revesPlano      Float @default(0)
  topspinDerecha  Float @default(0)
  topspinReves    Float @default(0)
  corte           Float @default(0)
  bloqueoDerecha  Float @default(0)
  bloqueoReves    Float @default(0)
  servicio        Float @default(0)
  recepcion       Float @default(0)
  movilidad       Float @default(0)
  fortalezaMental Float @default(0)
  experiencia     Float @default(0)

  // Relaciones
  matchId           String?           @map("match_id")
  match             Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)

  trainingSessionId String?           @map("training_session_id")
  trainingSession   TrainingSession?  @relation(fields: [trainingSessionId], references: [id], onDelete: SetNull)

  generalTrainingId String?           @map("general_training_id")
  generalTraining   GeneralTraining?  @relation(fields: [generalTrainingId], references: [id], onDelete: SetNull)

  player            User              @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("player_skill_update")
}

model GeneralTrainingSchedule {
  id          String   @id @default(uuid())
  clubId      String   @map("club_id")
  name        String   @db.VarChar(255)    
  startTime   String   @map("start_time")  
  endTime     String   @map("end_time")    
  daysOfWeek  Int[]    @map("days_of_week") 
  
  club        Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  trainings   GeneralTraining[]

  @@map("general_training_schedule")
}

model GeneralTraining {
  id               String   @id @default(uuid())
  clubId           String   @map("club_id")
  seasonId         String?  @map("season_id")
  description      String?  @db.Text
  date             DateTime @db.Date

  scheduleId       String?               @map("schedule_id")
  templateId       String                @map("template_id")

  club             Club                    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season           Season?                 @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  schedule         GeneralTrainingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  template         SkillUpdateTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  skillUpdates     PlayerSkillUpdate[]
  attendances      GeneralTrainingAttendance[]
  
  @@map("general_training")
}

model GeneralTrainingAttendance {
  id                String   @id @default(uuid())
  generalTrainingId String   @map("general_training_id")
  clubId            String   @map("club_id")
  playerId          String   @map("player_id")
  attended          Boolean  @default(true) 
  createdAt         DateTime @default(now()) @map("created_at")

  generalTraining   GeneralTraining @relation(fields: [generalTrainingId], references: [id], onDelete: Cascade)
  club              Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  player            User            @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([generalTrainingId, playerId])
  @@map("general_training_attendance")
}

model Team {
  id          String      @id @default(uuid())
  name        String
  category    String      
  level       String      
  
  clubId      String
  seasonId    String?     @map("season_id")
  
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season      Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  
  players     User[]      
  matches     TeamMatch[] 

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@map("team")
}

model TeamMatch {
  id          String   @id @default(uuid())
  
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  
  rivalName   String   
  date        DateTime 
  isHome      Boolean  
  location    String?  
  status      String   @default("Programado") 

  ourScore    Int?     
  rivalScore  Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("team_match")
}

model AppFeedback {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  type      FeedbackType
  content   String         @db.Text
  status    FeedbackStatus @default(Pendiente)
  createdAt DateTime       @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_feedback")
}


model ClubEvent {
  id        String   @id @default(uuid())
  clubId    String   @map("club_id")
  seasonId  String?  @map("season_id")
  name      String   @db.VarChar(255)
  region    EventRegion @default(Club)
  date      DateTime
  location  String?  @db.VarChar(255)
  color     String   @default("blue")
  createdAt DateTime @default(now()) @map("created_at")

  // Relaciones
  club      Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  season    Season?         @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  reminders EventReminder[]

  @@map("club_event")
}

model EventReminder {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  userId    String   @map("user_id")
  notifyAt  DateTime @db.Date @map("notify_at")
  isSent    Boolean  @default(false) @map("is_sent")

  event     ClubEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("event_reminder")
}